# ============================================================
# ENG Adobe Stock Studio — Environment Configuration
# ============================================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file containing real secrets.
# ============================================================

# Application
APP_ENV=development
APP_URL=http://localhost:3000

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
SUPABASE_SECRET_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# AI Provider (default: ollama)
AI_PROVIDER=ollama
IMAGE_GENERATION_PROVIDER=none

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# OpenRouter (cloud)
OPENROUTER_API_KEY=sk-or-your-openrouter-key
OPENROUTER_MODEL=meta-llama/llama-3-8b-instruct

# OpenAI (cloud)
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini

# Model assignments by task
PLANNER_MODEL=ollama
QC_MODEL=openrouter
METADATA_MODEL=ollama

# Workflow
MAX_AUTO_REVISIONS=2
